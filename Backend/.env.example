# ==========================================
# MentorSync Backend Environment Configuration
# ==========================================

# Server
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017/LeetcodeTracker
MONGO_DB=LeetcodeTracker

# Security & JWT
JWT_SECRET=your_production_256_bit_secret_key_here
JWT_EXPIR=900000
JWT_REFRESH_EXPIR=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# OAuth 2.0 (Google & GitHub)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend OAuth Callback URL
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
