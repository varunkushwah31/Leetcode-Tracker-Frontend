# ==========================================
# MentorSync Backend Environment Configuration
# ==========================================

# Server
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017/LeetcodeTracker
MONGO_DB=LeetcodeTracker

# Security & JWT
JWT_SECRET=your_production_256_bit_secret_key_here
JWT_EXPIR=900000
JWT_REFRESH_EXPIR=604800000

# Cookie Configuration
# In Local Dev: COOKIE_SECURE=false, COOKIE_SAME_SITE=Lax
# On Render (Production with https://mentorssync.vercel.app):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# OAuth 2.0 (Google & GitHub)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend OAuth Callback URL
# Local Dev: http://localhost:5173/oauth2/redirect
# Production (Render -> Vercel): https://mentorssync.vercel.app/oauth2/redirect
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# CORS Allowed Origins
# Production (Render): https://mentorssync.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://mentorssync.vercel.app,http://localhost:5173,http://localhost:3000,http://localhost:80

# Reverse Proxy / SSL Forwarding (Render terminates HTTPS)
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
