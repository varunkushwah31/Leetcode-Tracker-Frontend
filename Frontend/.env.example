# Backend API base URL
# In local dev: leave as /api (handled seamlessly by Vite dev proxy)
# In production on Vercel:
# VITE_API_BASE_URL=https://leettracker-backend-nq7r.onrender.com/api
VITE_API_BASE_URL=/api

# OAuth2 base URL (where /oauth2/authorization/{provider} lives)
# In local dev: omitted (handled by Vite dev proxy to localhost:8080)
# In production on Vercel:
# VITE_OAUTH_BASE_URL=https://leettracker-backend-nq7r.onrender.com
