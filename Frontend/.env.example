# Backend API base URL
# In local dev: leave as /api (handled seamlessly by Vite dev proxy)
# In production with separate API domain: e.g. https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Optional: Override OAuth2 base URL if backend authorization server is on a different origin
# VITE_OAUTH_BASE_URL=https://your-backend.onrender.com
